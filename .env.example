# Example environment configuration.

# Copy this file to .env and replace placeholder values with real secrets.

APP_NAME=AI Sales CRM
ENVIRONMENT=development
API_PREFIX=/api

CORS_ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_sales_crm
DB_USER=crm_app
DB_PASSWORD=your_mysql_password

# AI provider

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Legacy OpenAI settings (optional / compatibility only)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent settings

AGENT_ACTION_TTL_SECONDS=300
AGENT_RECURSION_LIMIT=8

# AI request controls

OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# JWT authentication

JWT_SECRET_KEY=generate_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Registration

ALLOW_PUBLIC_REGISTRATION=true
ALLOW_PUBLIC_REGISTRATION_IN_PRODUCTION=false
